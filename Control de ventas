<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sistema de Control de Ventas, Inventario y Finanzas USD</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Vue 3 CDN -->
    <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['"Plus Jakarta Sans"', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            50: '#f0f9ff',
                            100: '#e0f2fe',
                            500: '#0284c7',
                            600: '#0369a1',
                            700: '#075985',
                            800: '#0c4a6e',
                            900: '#0f172a',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        [v-cloak] { display: none !important; }
        /* Custom scrollbars */
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: #f1f5f9; }
        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
    </style>
</head>
<body class="bg-slate-50 font-sans text-slate-800 antialiased min-h-screen">
    <div id="app" v-cloak class="flex flex-col md:flex-row min-h-screen">

        <!-- Toast Notification system -->
        <div class="fixed top-4 right-4 z-50 flex flex-col gap-2 max-w-sm w-full pointer-events-none">
            <transition-group name="toast" enter-active-class="transform transition ease-out duration-300" enter-from-class="translate-y-2 opacity-0 sm:translate-y-0 sm:translate-x-2" enter-to-class="translate-y-0 opacity-100 sm:translate-x-0" leave-active-class="transition ease-in duration-100" leave-from-class="opacity-100" leave-to-class="opacity-0">
                <div v-for="toast in toasts" :key="toast.id" :class="[
                    'pointer-events-auto p-4 rounded-xl shadow-lg border flex items-center gap-3 text-sm font-medium',
                    toast.type === 'success' ? 'bg-emerald-900 border-emerald-700 text-emerald-100' :
                    toast.type === 'error' ? 'bg-rose-900 border-rose-700 text-rose-100' :
                    toast.type === 'warning' ? 'bg-amber-900 border-amber-700 text-amber-100' :
                    'bg-slate-900 border-slate-700 text-slate-100'
                ]">
                    <i :class="[
                        'text-lg',
                        toast.type === 'success' ? 'fa-solid fa-circle-check text-emerald-400' :
                        toast.type === 'error' ? 'fa-solid fa-circle-xmark text-rose-400' :
                        toast.type === 'warning' ? 'fa-solid fa-triangle-exclamation text-amber-400' :
                        'fa-solid fa-circle-info text-sky-400'
                    ]"></i>
                    <span class="flex-1">{{ toast.message }}</span>
                    <button @click="removeToast(toast.id)" class="text-slate-400 hover:text-white">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </div>
            </transition-group>
        </div>

        <!-- Sidebar Navigation -->
        <aside class="w-full md:w-64 bg-slate-900 text-slate-300 flex-shrink-0 flex flex-col justify-between border-r border-slate-800">
            <div>
                <!-- App Logo & Title -->
                <div class="p-5 border-b border-slate-800 flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-sky-500 to-indigo-600 flex items-center justify-center text-white text-xl font-bold shadow-md shadow-sky-500/20">
                        <i class="fa-solid fa-chart-line"></i>
                    </div>
                    <div>
                        <h1 class="font-bold text-white text-base leading-tight">Control POS</h1>
                        <p class="text-xs text-slate-400">Ventas & Finanzas USD</p>
                    </div>
                </div>

                <!-- Navigation Links -->
                <nav class="p-3 space-y-1">
                    <button @click="activeTab = 'dashboard'" :class="[activeTab === 'dashboard' ? 'bg-sky-600/20 text-sky-400 border-l-4 border-sky-500 font-semibold' : 'hover:bg-slate-800 text-slate-400 hover:text-slate-200', 'w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm transition-all']">
                        <i class="fa-solid fa-gauge-high w-5 text-center text-base"></i>
                        <span>Panel General</span>
                    </button>

                    <button @click="activeTab = 'inventory'" :class="[activeTab === 'inventory' ? 'bg-sky-600/20 text-sky-400 border-l-4 border-sky-500 font-semibold' : 'hover:bg-slate-800 text-slate-400 hover:text-slate-200', 'w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm transition-all']">
                        <i class="fa-solid fa-boxes-stacked w-5 text-center text-base"></i>
                        <span>Inventario</span>
                        <span v-if="lowStockCount > 0" class="ml-auto bg-amber-500/20 text-amber-400 text-xs px-2 py-0.5 rounded-full font-semibold border border-amber-500/30">
                            {{ lowStockCount }}
                        </span>
                    </button>

                    <button @click="activeTab = 'sales'" :class="[activeTab === 'sales' ? 'bg-sky-600/20 text-sky-400 border-l-4 border-sky-500 font-semibold' : 'hover:bg-slate-800 text-slate-400 hover:text-slate-200', 'w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm transition-all']">
                        <i class="fa-solid fa-cart-shopping w-5 text-center text-base"></i>
                        <span>Ventas & Despacho</span>
                    </button>

                    <button @click="activeTab = 'purchases'" :class="[activeTab === 'purchases' ? 'bg-sky-600/20 text-sky-400 border-l-4 border-sky-500 font-semibold' : 'hover:bg-slate-800 text-slate-400 hover:text-slate-200', 'w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm transition-all']">
                        <i class="fa-solid fa-truck-ramp-box w-5 text-center text-base"></i>
                        <span>Compras</span>
                    </button>

                    <button @click="activeTab = 'finance'" :class="[activeTab === 'finance' ? 'bg-sky-600/20 text-sky-400 border-l-4 border-sky-500 font-semibold' : 'hover:bg-slate-800 text-slate-400 hover:text-slate-200', 'w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm transition-all']">
                        <i class="fa-solid fa-vault w-5 text-center text-base"></i>
                        <span>Cajas & Bancos USD</span>
                    </button>

                    <button @click="activeTab = 'receivables'" :class="[activeTab === 'receivables' ? 'bg-sky-600/20 text-sky-400 border-l-4 border-sky-500 font-semibold' : 'hover:bg-slate-800 text-slate-400 hover:text-slate-200', 'w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm transition-all']">
                        <i class="fa-solid fa-hand-holding-dollar w-5 text-center text-base"></i>
                        <span>Cuentas por Cobrar</span>
                        <span v-if="pendingReceivablesCount > 0" class="ml-auto bg-emerald-500/20 text-emerald-400 text-xs px-2 py-0.5 rounded-full font-semibold border border-emerald-500/30">
                            {{ pendingReceivablesCount }}
                        </span>
                    </button>

                    <button @click="activeTab = 'payables'" :class="[activeTab === 'payables' ? 'bg-sky-600/20 text-sky-400 border-l-4 border-sky-500 font-semibold' : 'hover:bg-slate-800 text-slate-400 hover:text-slate-200', 'w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm transition-all']">
                        <i class="fa-solid fa-file-invoice-dollar w-5 text-center text-base"></i>
                        <span>Cuentas por Pagar</span>
                        <span v-if="pendingPayablesCount > 0" class="ml-auto bg-rose-500/20 text-rose-400 text-xs px-2 py-0.5 rounded-full font-semibold border border-rose-500/30">
                            {{ pendingPayablesCount }}
                        </span>
                    </button>

                    <button @click="activeTab = 'history'" :class="[activeTab === 'history' ? 'bg-sky-600/20 text-sky-400 border-l-4 border-sky-500 font-semibold' : 'hover:bg-slate-800 text-slate-400 hover:text-slate-200', 'w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm transition-all']">
                        <i class="fa-solid fa-clock-rotate-left w-5 text-center text-base"></i>
                        <span>Historial & Movimientos</span>
                    </button>
                </nav>
            </div>

            <!-- Quick Financial Summary Footer -->
            <div class="p-4 bg-slate-950/60 m-3 rounded-xl border border-slate-800 space-y-2">
                <div class="text-xs text-slate-400 font-medium flex justify-between items-center">
                    <span>Capital Disponible</span>
                    <i class="fa-solid fa-shield-halved text-emerald-400"></i>
                </div>
                <div class="text-xl font-bold text-emerald-400">
                    ${{ formatNumber(totalLiquidMoney) }}
                </div>
                <div class="pt-2 border-t border-slate-800/80 text-[11px] grid grid-cols-2 gap-1 text-slate-400">
                    <div>Banco: <span class="text-slate-200 font-semibold">${{ formatNumber(balances.bank) }}</span></div>
                    <div>Efectivo: <span class="text-slate-200 font-semibold">${{ formatNumber(balances.cash) }}</span></div>
                </div>
            </div>
        </aside>

        <!-- Main Content Area -->
        <main class="flex-1 flex flex-col min-w-0 overflow-x-hidden">

            <!-- Top Header bar -->
            <header class="bg-white border-b border-slate-200 px-6 py-4 flex flex-col sm:flex-row sm:items-center justify-between gap-4 sticky top-0 z-20 shadow-sm">
                <div>
                    <h2 class="text-xl font-bold text-slate-900">
                        <span v-if="activeTab === 'dashboard'"><i class="fa-solid fa-gauge-high text-sky-600 mr-2"></i>Panel de Control General</span>
                        <span v-if="activeTab === 'inventory'"><i class="fa-solid fa-boxes-stacked text-sky-600 mr-2"></i>Gestión de Productos e Inventario</span>
                        <span v-if="activeTab === 'sales'"><i class="fa-solid fa-cart-shopping text-sky-600 mr-2"></i>Módulo de Ventas y Despacho</span>
                        <span v-if="activeTab === 'purchases'"><i class="fa-solid fa-truck-ramp-box text-sky-600 mr-2"></i>Módulo de Compras a Proveedores</span>
                        <span v-if="activeTab === 'finance'"><i class="fa-solid fa-vault text-sky-600 mr-2"></i>Control de Dinero (Banco y Efectivo)</span>
                        <span v-if="activeTab === 'receivables'"><i class="fa-solid fa-hand-holding-dollar text-emerald-600 mr-2"></i>Cuentas por Cobrar (Clientes)</span>
                        <span v-if="activeTab === 'payables'"><i class="fa-solid fa-file-invoice-dollar text-rose-600 mr-2"></i>Cuentas por Pagar (Proveedores)</span>
                        <span v-if="activeTab === 'history'"><i class="fa-solid fa-clock-rotate-left text-slate-600 mr-2"></i>Historial de Transacciones</span>
                    </h2>
                    <p class="text-xs text-slate-500 mt-0.5">Todas las cifras presentadas están en Dólares Estadounidenses (USD $)</p>
                </div>

                <!-- Top Quick Stats & Actions -->
                <div class="flex items-center gap-3">
                    <button @click="openAdjustBalanceModal()" class="px-3 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold rounded-lg flex items-center gap-1.5 transition">
                        <i class="fa-solid fa-pen-to-square text-sky-600"></i>
                        <span>Ajustar Cajas/Banco</span>
                    </button>
                    <button @click="openProductModal()" class="px-3 py-2 bg-sky-600 hover:bg-sky-700 text-white text-xs font-semibold rounded-lg flex items-center gap-1.5 shadow-sm transition">
                        <i class="fa-solid fa-plus"></i>
                        <span>Nuevo Producto</span>
                    </button>
                </div>
            </header>

            <div class="p-6 flex-1 overflow-y-auto">

                <!-- 1. DASHBOARD TAB -->
                <div v-if="activeTab === 'dashboard'" class="space-y-6">

                    <!-- Key Metrics Grid -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                        <!-- Banco Balance Card -->
                        <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-sm relative overflow-hidden group">
                            <div class="flex justify-between items-start">
                                <div>
                                    <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Saldo en Banco</p>
                                    <h3 class="text-2xl font-extrabold text-slate-900 mt-1">${{ formatNumber(balances.bank) }}</h3>
                                    <p class="text-xs text-slate-400 mt-1">Dólares bancarios</p>
                                </div>
                                <div class="w-12 h-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center text-xl font-bold">
                                    <i class="fa-solid fa-building-columns"></i>
                                </div>
                            </div>
                        </div>

                        <!-- Efectivo Balance Card -->
                        <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-sm relative overflow-hidden group">
                            <div class="flex justify-between items-start">
                                <div>
                                    <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Saldo en Efectivo</p>
                                    <h3 class="text-2xl font-extrabold text-emerald-600 mt-1">${{ formatNumber(balances.cash) }}</h3>
                                    <p class="text-xs text-slate-400 mt-1">Caja física USD</p>
                                </div>
                                <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-xl font-bold">
                                    <i class="fa-solid fa-money-bill-wave"></i>
                                </div>
                            </div>
                        </div>

                        <!-- Cuentas por Cobrar Card -->
                        <div @click="activeTab = 'receivables'" class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-sm relative overflow-hidden group cursor-pointer hover:border-emerald-300 transition">
                            <div class="flex justify-between items-start">
                                <div>
                                    <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Por Cobrar (Clientes)</p>
                                    <h3 class="text-2xl font-extrabold text-amber-600 mt-1">${{ formatNumber(totalReceivables) }}</h3>
                                    <p class="text-xs text-slate-400 mt-1">{{ pendingReceivablesCount }} pendientes</p>
                                </div>
                                <div class="w-12 h-12 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center text-xl font-bold">
                                    <i class="fa-solid fa-hand-holding-dollar"></i>
                                </div>
                            </div>
                        </div>

                        <!-- Cuentas por Pagar Card -->
                        <div @click="activeTab = 'payables'" class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-sm relative overflow-hidden group cursor-pointer hover:border-rose-300 transition">
                            <div class="flex justify-between items-start">
                                <div>
                                    <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Por Pagar (Proveedores)</p>
                                    <h3 class="text-2xl font-extrabold text-rose-600 mt-1">${{ formatNumber(totalPayables) }}</h3>
                                    <p class="text-xs text-slate-400 mt-1">{{ pendingPayablesCount }} pendientes</p>
                                </div>
                                <div class="w-12 h-12 rounded-xl bg-rose-50 text-rose-600 flex items-center justify-center text-xl font-bold">
                                    <i class="fa-solid fa-file-invoice-dollar"></i>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Net Capital & Inventory Valuation Overview -->
                    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                        <div class="lg:col-span-2 bg-gradient-to-br from-slate-900 to-slate-800 text-white p-6 rounded-2xl shadow-md border border-slate-700/80 flex flex-col justify-between">
                            <div>
                                <div class="flex justify-between items-center mb-4">
                                    <span class="text-xs font-bold uppercase tracking-wider text-sky-400 bg-sky-950/80 px-2.5 py-1 rounded-full border border-sky-800">Resumen Financiero Neto</span>
                                    <span class="text-xs text-slate-400"><i class="fa-regular fa-clock mr-1"></i>Actualizado en tiempo real</span>
                                </div>

                                <div class="grid grid-cols-1 md:grid-cols-3 gap-4 my-4 border-y border-slate-700/60 py-4">
                                    <div>
                                        <p class="text-xs text-slate-400">Patrimonio Líquido (Banco+Caja)</p>
                                        <p class="text-xl font-bold text-white mt-1">${{ formatNumber(totalLiquidMoney) }}</p>
                                    </div>
                                    <div>
                                        <p class="text-xs text-slate-400">Valor Inventario (al costo)</p>
                                        <p class="text-xl font-bold text-sky-400 mt-1">${{ formatNumber(totalInventoryValue) }}</p>
                                    </div>
                                    <div>
                                        <p class="text-xs text-slate-400">Balance Neto Teórico</p>
                                        <p class="text-xl font-bold text-emerald-400 mt-1">${{ formatNumber(totalLiquidMoney + totalReceivables + totalInventoryValue - totalPayables) }}</p>
                                    </div>
                                </div>
                            </div>

                     
